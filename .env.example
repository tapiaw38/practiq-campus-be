APP_NAME=practiq-campus-be
GIN_MODE=debug
PORT=8084

DATABASE_URL=postgres://postgres:postgres@localhost:55432/practiq-campus-db?sslmode=disable

# Must match auth-api-be / practiq-be JWT_SECRET exactly (minimum 32 characters)
JWT_SECRET=your-jwt-secret-here-at-least-32-chars-long-example

AUTH_API_URL=http://localhost:8082
PRACTIQ_API_URL=http://localhost:8083
FRONTEND_URL=http://localhost:5175

# Optional S3-compatible private storage for course materials. If empty,
# upload endpoints report storage not configured. AWS_ENDPOINT supports
# MinIO/R2; leave it empty for AWS S3.
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ENDPOINT=
